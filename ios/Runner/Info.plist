<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ================================================================== -->
	<!-- Standard Flutter app keys                                          -->
	<!-- ================================================================== -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Background Health Sync</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>background_health_sync</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- ================================================================== -->
	<!-- Background Modes                                                   -->
	<!-- These enable the app to execute code while backgrounded or when    -->
	<!-- the screen is locked.                                              -->
	<!--                                                                    -->
	<!-- For BLE scanning, you would add:                                   -->
	<!--   bluetooth-central  — Use CoreBluetooth as a central device      -->
	<!--   bluetooth-peripheral — Act as a BLE peripheral (if needed)      -->
	<!--   location — Required for iBeacon region monitoring               -->
	<!-- ================================================================== -->
	<key>UIBackgroundModes</key>
	<array>
		<!-- Enables BGAppRefreshTask scheduling -->
		<string>fetch</string>
		<!-- Enables BGProcessingTask scheduling -->
		<string>processing</string>
	</array>

	<!-- ================================================================== -->
	<!-- BGTaskScheduler Permitted Identifiers                              -->
	<!-- Every task identifier used with BGTaskScheduler.register() and     -->
	<!-- BGTaskScheduler.submit() MUST be listed here.                      -->
	<!-- ================================================================== -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.example.backgroundsync.refresh</string>
		<string>com.example.backgroundsync.processing</string>
	</array>

	<!-- ================================================================== -->
	<!-- HealthKit Capability                                               -->
	<!-- Required for HealthKit data access. For BLE, this would be        -->
	<!-- replaced with NSBluetoothAlwaysUsageDescription.                   -->
	<!-- ================================================================== -->
	<key>NSHealthShareUsageDescription</key>
	<string>This app reads your health data to sync it in the background.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>This app may write health data summaries.</string>
</dict>
</plist>
